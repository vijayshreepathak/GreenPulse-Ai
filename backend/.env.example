# GreenPulse AI backend configuration. Copy to backend/.env and fill in real values locally.
# backend/.env is git-ignored; never commit a real key. Changes are picked up without a restart.

# Google Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# Leave empty to keep the Copilot unavailable.
GEMINI_API_KEY=your-gemini-api-key-here

# Primary model used by the GreenPulse AI Copilot.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional fallback, tried once when the primary is out of quota, rate-limited, unavailable or
# overloaded. Answers show which model actually replied. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# true / false. When false the Copilot launcher is hidden and /api/ai/chat refuses requests.
AI_ASSISTANT_ENABLED=true

# Read-only data tool calls per question (0-4).
AI_MAX_TOOL_CALLS=4

# Earlier conversation messages sent with each question (0-20).
AI_MAX_HISTORY_MESSAGES=12

# Overall time limit for one Copilot answer, in seconds (5-120).
AI_TIMEOUT_SECONDS=60
